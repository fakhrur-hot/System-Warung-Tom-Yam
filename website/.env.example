# Copy to .env.local (git-ignored) and fill in.
# Both values are client-safe (the publishable key is meant to ship in the bundle).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Optional. AdSense client ID (ca-pub-XXXXXXXXXXXXXXXX) — leave unset to ship with no ads at all
# (loadAdSense() no-ops cleanly when this is blank). Loads Google's auto-ads only on the
# customer-facing ordering page (src/lib/adsense.ts), never the /admin dashboard.
VITE_ADSENSE_CLIENT_ID=

# Optional. Slot ID (digits only) of a responsive DISPLAY ad unit, shown at the bottom of the
# order-status view while a customer waits for their food. Create it in AdSense under
# Ads → By ad unit → Display ads → Responsive. Unset = the status view renders no ad unit.
VITE_ADSENSE_STATUS_SLOT=

# ── Adsterra ────────────────────────────────────────────────────────────────
# All optional. When ANY in-flow Adsterra unit below is configured it takes over the ad slots and
# AdSense is skipped entirely (see src/components/AdSlot.tsx) — running both on one page view
# risks an AdSense policy strike, since AdSense holds you responsible for what appears beside it.
# Unset everything here to fall back to AdSense.

# Native Banner (preferred): both values come from the same snippet in Adsterra.
# SRC is the invoke.js URL; CONTAINER is the id of the <div> in that snippet. Both are required —
# their script looks the div up by that exact id, so a mismatch silently fills nothing.
VITE_ADSTERRA_NATIVE_SRC=
VITE_ADSTERRA_NATIVE_CONTAINER=

# Banner (iframe format). The 'key' from the unit's snippet. Rendered inside a sandboxed iframe,
# because this format's invoke.js uses document.write, which would wipe the SPA if run inline.
# Size MUST match the size the unit was created at or Adsterra returns no fill.
VITE_ADSTERRA_BANNER_KEY=
VITE_ADSTERRA_BANNER_WIDTH=300
VITE_ADSTERRA_BANNER_HEIGHT=250

# SmartLink / Direct Link: the FULL destination URL from Adsterra -> SmartLinks (not just the ID).
# It has no visual format, so it renders as a labelled 'Ad / Sponsored offers' link that opens in a
# new tab -- never a redirect, which would take a customer away mid-order.
VITE_ADSTERRA_SMARTLINK_URL=

# Social Bar / Popunder — a page-level script. Opt-in and deliberately separate: these formats can
# overlay or open windows mid-order, competing with the customer actually placing their order.
VITE_ADSTERRA_SOCIAL_BAR_SRC=

# Optional. Display name for the café, used in the app title and QR sheets.
# Defaults to "RAZ POS" when unset.
VITE_CAFE_NAME=

# Optional. Android app package name for .well-known/assetlinks.json deep-link verification.
# Defaults to com.razstudio.pos when unset.
VITE_APP_PACKAGE_NAME=

# Optional. SHA-256 certificate fingerprint for .well-known/assetlinks.json.
# Required for Android deep links to work on branded builds.
# Format: AA:BB:CC:... (colon-separated hex bytes)
VITE_APP_SHA256_FINGERPRINT=
