# Copy to .env.local (git-ignored) and fill in.
# Both values are client-safe (the publishable key is meant to ship in the bundle).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Optional. AdSense client ID (ca-pub-XXXXXXXXXXXXXXXX) — leave unset to ship with no ads at all
# (loadAdSense() no-ops cleanly when this is blank). Loads Google's auto-ads only on the
# customer-facing ordering page (src/lib/adsense.ts), never the /admin dashboard.
VITE_ADSENSE_CLIENT_ID=

# Optional. Slot ID (digits only) of a responsive DISPLAY ad unit, shown at the bottom of the
# order-status view while a customer waits for their food. Create it in AdSense under
# Ads → By ad unit → Display ads → Responsive. Unset = the status view renders no ad unit.
VITE_ADSENSE_STATUS_SLOT=

# ── RollerAds ───────────────────────────────────────────────────────────────
# Page-level only. RollerAds has NO in-page display format -- its formats are push notifications,
# in-page push and OnClick/popunder -- so nothing here feeds the in-page ad slots. Those continue
# to serve AdSense above, which is deliberate: RollerAds' push inventory does not compete for the
# same on-page space and they market it as AdSense-friendly.
#
# Be aware what enabling this does to a table-QR ordering page: push triggers a browser permission
# prompt, and popunder opens a window on interaction -- both on the surface whose job is capturing
# an order. Which formats fire is set per-site in the RollerAds dashboard, NOT here; nothing in
# this app can suppress an individual format.

# The FULL script src from my.rollerads.com -> your site -> get code. Must be the whole URL: the
# host and path are issued by RollerAds and cannot be derived from the site id, so a hand-built
# URL loads nothing while looking configured.
VITE_ROLLERADS_TAG_SRC=

# Site id from the dashboard. Informational only -- the tag URL already embeds it.
VITE_ROLLERADS_SITE_ID=
