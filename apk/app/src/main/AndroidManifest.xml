<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Package visibility (Android 11 / API 30+).

        Without this block, `getPackageInfo`, `queryIntentServices` and `bindService` against
        another app all behave as if that app were not installed — no error, no permission prompt,
        just NameNotFoundException and an empty query result. targetSdk is 36, so the filtering is
        active, and every Sunmi integration in this app goes through exactly those calls:
        `SunmiPrinterDriver.availability()` reported the built-in printer as absent on a terminal
        that plainly has one, which in turn hid it from Devices & Hardware and from the Printers
        screen, and would have made the AIDL bind fail even if it had been selected.

        Declaring the package is enough; no permission is involved. QUERY_ALL_PACKAGES is the wrong
        tool here — it is a Play-policy-sensitive blanket grant, and we need exactly two packages.
    -->
    <queries>
        <!-- Built-in thermal printer and cash drawer (H9). -->
        <package android:name="woyou.aidlservice.jiuiv5" />
        <!-- Barcode/QR scanner service (H4). -->
        <package android:name="com.sunmi.scanner" />
        <!-- Bind target, declared as an intent too so an OEM that renames the package still resolves. -->
        <intent>
            <action android:name="woyou.aidlservice.jiuiv5.IWoyouService" />
        </intent>
    </queries>

    <!-- Bluetooth permissions: legacy (pre-Android 12) -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- Bluetooth permissions: Android 12+ (API 31+) — covers Android 12, 13, 14, 15 -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />

    <!-- Network: Realtime WebSocket connection -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Saving the closing report into Downloads.

      API 29+ needs NO permission for this: scoped storage lets an app write to the Downloads
      collection through MediaStore without asking. maxSdkVersion caps the request at 28 so the
      tills this actually runs on never see a storage prompt, while an older device still has the
      legacy public-directory path available. See ClosingReportSaver.
    -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Foreground service: keeps Realtime subscription alive -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!--
        remoteMessaging, not dataSync. Android 15 caps dataSync at ~6 hours per app per day; a till
        that opens at 07:00 has its service killed by early afternoon and REFUSED a restart until the
        window resets, so the café loses realtime orders and kitchen printing for the rest of the day.
        Observed on this device: ForegroundServiceDidNotStopInTimeException, then
        ForegroundServiceStartNotAllowedException on every retry.

        connectedDevice was tried first and rejected at runtime: it additionally requires one of
        BLUETOOTH_CONNECT / CHANGE_WIFI_STATE / NFC / … to be *granted*, and BLUETOOTH_CONNECT is a
        runtime permission this café had declined. The service would then have crashed on launch for
        any café that does not print over Bluetooth — a worse failure than the one being fixed.

        remoteMessaging needs no permission beyond its own, has no daily quota, and is the honest
        description of the continuous work: receiving order and status events for this café and
        relaying them to its staff devices.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />

    <!-- Foreground service: special use type for payment notification listener (API 34+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Battery optimization exemption request -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Boot restart: restart service after device reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Notification permission (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Location: GPS lock for café attendance and geofencing -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Foreground service: location type for attendance GPS checks -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Camera: in-app QR scanner for ordering-device onboarding -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".PosApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.WarungTomYam">

        <!--
            Both OSS-licences screens, re-themed. BOTH matter: the menu lists the libraries and the
            second shows one licence's text, so theming only the first swaps a crash on open for a
            crash on tap.
        -->
        <activity
            android:name="com.google.android.gms.oss.licenses.OssLicensesMenuActivity"
            android:theme="@style/Theme.WarungTomYam.Licenses"
            tools:replace="android:theme" />
        <activity
            android:name="com.google.android.gms.oss.licenses.OssLicensesActivity"
            android:theme="@style/Theme.WarungTomYam.Licenses"
            tools:replace="android:theme" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.WarungTomYam">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link / App Link for the staff invite: scanning the invite QR (or opening
                 the link) on a device with this app installed launches it straight into the
                 ordering-device onboarding with the ?invite= token. autoVerify makes it a
                 verified App Link where the host serves /.well-known/assetlinks.json; where it
                 doesn't, Android still offers this app as a handler. The payload is a normal
                 https URL, so any generic QR reader still reads it as a link. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="${deepLinkHost}"
                    android:pathPrefix="/join" />
            </intent-filter>
        </activity>

        <!-- Foreground service for Supabase Realtime subscription (Spike 02) -->
        <service
            android:name=".realtime.RealtimeService"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging" />

        <!-- Foreground service for ordering staff (GPS attendance + café status) -->
        <service
            android:name=".realtime.OrderingForegroundService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Payment notification listener: captures eWallet payment notifications -->
        <service
            android:name=".notification.PaymentNotificationListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <meta-data
                android:name="android.app.foregroundServiceType"
                android:value="specialUse" />
        </service>

        <!-- Restart admin service after device reboot -->
        <receiver
            android:name=".realtime.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Restart ordering service after device reboot (if ordering role) -->
        <receiver
            android:name=".realtime.OrderingBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Restart payment listener after device reboot -->
        <receiver
            android:name=".notification.PaymentBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- FileProvider for sharing generated PDFs (API 26-28 fallback) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Google Mobile Ads SDK initialization -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-8323843054100465~4507739104" />
    </application>

</manifest>
