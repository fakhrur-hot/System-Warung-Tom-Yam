<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Neutral template palette (indigo) — the generic vendor default shipped with the template build,
         with no café branding. A café-specific build overrides these values to its own colors. The
         resource names (tom_yam_50, etc.) are kept stable so the theme wiring downstream needs no
         changes. These map to the TomYam* ramp names in Color.kt. -->

    <!-- Primary ramp (10 shades from 50-900): spicy orange-red Tom Yam broth -->
    <color name="tom_yam_50">#FFF5F0</color>  <!-- creamy broth page background / input tint -->
    <color name="tom_yam_100">#FFE6D9</color> <!-- light peach containers, chips -->
    <color name="tom_yam_200">#FFC4B0</color>
    <color name="tom_yam_300">#FF9B7A</color>
    <color name="tom_yam_400">#F36B44</color>
    <color name="tom_yam_500">#D94824</color>
    <color name="tom_yam_600">#B52D10</color> <!-- Tom Yam red — primary accent, buttons, active states -->
    <color name="tom_yam_700">#8F210A</color> <!-- deep chilli hover / pressed -->
    <color name="tom_yam_800">#691808</color>
    <color name="tom_yam_900">#430F05</color> <!-- rich red-brown headings / primary text -->

    <!-- Neutral muted slate for secondary text. -->
    <color name="tom_yam_muted">#6B7280</color>
    <color name="tom_yam_outline">#FFC4B0</color>
    <!-- The logo's own paper white; the adaptive icon's background layer. -->
    <color name="ic_launcher_background">#FFFFFF</color>
</resources>