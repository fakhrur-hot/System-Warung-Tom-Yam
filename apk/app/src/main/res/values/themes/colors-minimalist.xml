    <color name="tom_yam_300">#D1D1D6</color>
    <color name="tom_yam_400">#A1A1AA</color>
    <color name="tom_yam_500">#71717A</color>
    <color name="tom_yam_600">#27272A</color> <!-- charcoal primary — buttons, active states -->
    <color name="tom_yam_700">#18181B</color> <!-- near-black hover -->
    <color name="tom_yam_800">#09090B</color>
    <color name="tom_yam_900">#000000</color> <!-- pure black headings -->

    <color name="tom_yam_muted">#71717A</color>
    <color name="tom_yam_outline">#E4E4E7</color>
