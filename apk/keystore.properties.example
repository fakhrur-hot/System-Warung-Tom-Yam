# Copy to keystore.properties (git-ignored) to sign release builds.
# When absent, release builds are UNSIGNED so CI still compiles.
# Generate a keystore:
#   keytool -genkeypair -v -keystore warung-release.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias warung
storeFile=/absolute/path/to/warung-release.jks
storePassword=CHANGE_ME
keyAlias=warung
keyPassword=CHANGE_ME
